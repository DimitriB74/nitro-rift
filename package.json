{
  "name": "nitro-rift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NITRO RIFT — jeu de course arcade 3D multijoueur jouable dans le navigateur",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n serveur,client -c cyan,magenta \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "tracks": "node scripts/build-tracks.js",
    "calibrate": "node scripts/calibrate-medals.js",
    "verifier": "node scripts/verifier.js",
    "test:multi": "node test/multijoueur.mjs",
    "test:garage": "node test/garage.mjs",
    "test:gp": "node test/grandprix.mjs",
    "test:navigateur": "node test/salon-navigateur.mjs && node test/garage-navigateur.mjs",
    "test": "npm run verifier && npm run test:garage && npm run test:multi && npm run test:gp"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.169.0",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "license": "MIT"
}
