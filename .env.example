# Copier ce fichier en .env pour le développement local.

# Chaîne de connexion MongoDB Atlas (obligatoire en production).
# Laisser vide en local : le serveur démarre alors en mode « sans base »
# (comptes non sauvegardés, utile pour tester la course rapidement).
MONGODB_URI=

# Clé secrète pour signer les jetons JWT. Mettre une longue chaîne aléatoire.
JWT_SECRET=changez-cette-cle-secrete

# Clé d'accès à la page /admin (réinitialisation de mot de passe).
ADMIN_KEY=changez-cette-cle-admin

# Port d'écoute. Render fournit automatiquement cette variable.
PORT=3000
